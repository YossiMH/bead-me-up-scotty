  "defects": [
    "Set-v2 staging never inserts attempt IDs into its shared seen_attempt_ids set, so its reported count is zero and duplicate identities are not rejected across artifacts.",
    "Publication rewrites set/tail.jsonl while retained generation manifests still select its prior bytes."
  ],
  "production_changes": [
    "Insert every staged attempt_id into the existing shared set and refuse duplicates before extending the outcome vector.",
    "Publish the logical open tail with the existing content-addressed object writer; preserve old selected tail bytes through existing structural retention.",
    "Describe immutable selected tail objects and legacy fixed-path compatibility in the existing set-v2 specification."
  ],
  "unchanged_contracts": [
    "checkpoint configuration",
    "public format and schema versions",
    "sealing thresholds and logical segment boundaries",
    "published count definitions and verification requirements",
    "editing APIs and browser assertions"
