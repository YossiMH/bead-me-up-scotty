  "findings": [
    {
      "path": "src/cli_checkpoint_guard.rs",
      "function": "acquire",
      "lines": "113-137",
      "lock": ".beads/operation.lock",
      "status": "same remaining Windows contention defect",
      "detail": "The match retries only ErrorKind::WouldBlock and returns Error::Io for the fs2 Windows raw contention error. The pre-dispatch guard prevents the losing command from reaching its committed-state/revision check.",
      "preserve": [
        "30-second deadline",
        "10-ms poll",
        "DatabaseBusy timeout and unrelated I/O errors",
        "policy and conflict/writable validation order",
        "RAII unlocking and pre-publication release"
      ],
      "tests": [
        "tests/r036_verified_restore.rs::simultaneous_empty_target_restores_have_one_winner_and_one_refusal",
        "tests/cli_editing.rs::concurrent_editors_with_one_revision_have_one_complete_winner"
      ]
    },
    {
      "path": "src/service/redaction.rs",
      "function": "acquire_maintenance_lock",
      "lines": "1706-1728",
      "lock": ".beads/maintenance.lock",
      "status": "same remaining Windows contention defect",
      "detail": "The private maintenance loop also retries only WouldBlock and maps the same native contention to a generic integrity error. acquire_redaction_locks takes maintenance before checkpoint publication, including direct service callers that bypass the CLI guard.",
      "preserve": [
        "LOCK_TIMEOUT=30 seconds",
        "LOCK_POLL=10 ms",
        "existing busy and unrelated acquisition integrity errors",
        "maintenance-before-publication ordering",
        "RAII guards and public redaction behavior"
      ],
      "tests": [
        "tests/redaction_transaction.rs::concurrent_identical_requests_commit_once_and_replay_once"
      ]
    },
    {
      "path": "src/service/checkpoint.rs",
      "function": "acquire_checkpoint_publication_lock_within",
      "lines": "7727-7765",
      "lock": ".beads/checkpoint/publish.lock",
      "status": "already repaired in c90",
      "detail": "Retries WouldBlock or equality to fs2::lock_contended_error().raw_os_error(); its bounded wait and all other errors remain unchanged. No further source change is proposed here."
    }
  ],
  "recommended_product_change": "Change only the two remaining match predicates to the same platform-aware contention expression already present in the publication loop. Keep the existing independent functions and their errors, deadlines, policies, lock order and guards.",
  "recommended_verification": "Preserve the two actual operation-lock race failures as Red. Include the existing complete six-case redaction_transaction target in Windows compilation and the editing partition, alongside unchanged restore/editing targets. The existing direct-service race is a meaningful maintenance-lock regression and requires no oracle edit. Backend owner and root select any required additional actual Red execution and final-source qualification through the plan amendment.",
